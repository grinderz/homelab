# Hub data (sqlite, backups, the hub's ssh key). Unraid: /mnt/user/appdata/beszel
DATA_DIR=/mnt/user/appdata/beszel
# Web UI port on the host
PORT=8090
# Agent: port it listens on (host network) and the hub's public key, shown in
# the hub UI under Settings > Add system, or in DATA_DIR/id_ed25519.pub
AGENT_PORT=45876
AGENT_KEY=ssh-ed25519 AAAA...
TZ=UTC
