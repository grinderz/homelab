# Host paths. Unraid: /mnt/user/cloud/... ; Proxmox: whatever the datastore is.
DATA_DIR=/mnt/user/cloud
HISTORY_DIR=/mnt/user/cloud-history
# Owner of written files. Unraid: 99:100 (nobody:users). Proxmox LXC/VM: your uid:gid.
PUID=99
PGID=100
TZ=UTC
# Which remotes from config/rclone.conf to mirror, and how often.
REMOTES=yandex gdrive
INTERVAL=6h
HISTORY_DAYS=365
# Optional healthchecks.io / gatus URL. Empty = no pings.
PING_URL=
# Alerts through the notify stack (Apprise). Default reaches it over the proxy
# network; empty = no alerts. NOTIFY_OK=1 also reports successful runs.
NOTIFY_URL=http://notify:8000/notify/homelab
NOTIFY_OK=
