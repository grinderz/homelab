# Postgres data of the stack's own database. Unraid: /mnt/user/appdata/miniflux/db
DATA_DIR=/mnt/user/appdata/miniflux/db
# Daily pg_dump files for the backups, keep DUMP_KEEP of them. Unraid: /mnt/user/appdata/miniflux/dumps
DUMP_DIR=/mnt/user/appdata/miniflux/dumps
DUMP_KEEP=7
# Web UI port on the host
PORT=8094
TZ=UTC
# Password of the miniflux database role (rendered from passp by dotfiles)
DB_PASSWORD=
# Fresh install only: create the first admin on start, then set back to 0
CREATE_ADMIN=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
