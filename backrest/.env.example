# backrest state (config.json, operation log, restic cache). Unraid: /mnt/user/appdata/backrest
DATA_DIR=/mnt/user/appdata/backrest
CACHE_DIR=/mnt/user/appdata/backrest/cache
# local restic repository, on a disk other than the data it protects
# (Unraid: a disk path, not /mnt/user, so it never lands on the cache pool)
REPO_DIR=/mnt/disk2/backup/restic
# Web UI port on the host (no auth: LAN only)
PORT=9898
TZ=UTC
