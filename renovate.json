{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Istanbul",
  "schedule": ["before 9am on saturday"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["deps"],
  "prConcurrentLimit": 5,
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "A postgres major is a dump/restore done by hand (miniflux/README.md), no PR for it",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Image minor/patch bumps of every stack in one weekly PR",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "container images"
    },
    {
      "description": "Majors one per image, never auto-grouped",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Tooling pins (pre-commit hooks) in their own PR",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "shellcheck release installed by the CI lint job",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["SHELLCHECK_VERSION: (?<currentValue>\\S+)"],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
